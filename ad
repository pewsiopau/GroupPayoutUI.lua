-- CAPTCHA Logic
local currentCaptcha = ""

-- Generate random CAPTCHA (6 alphanumeric characters)
local function generateCaptcha()
    local chars = "ABCDEFGHJKLMNPQRSTUVWXYZ23456789" -- Exclude easily confused chars
    local captcha = ""
    for i = 1, 6 do
        local rand = math.random(1, #chars)
        captcha = captcha .. string.sub(chars, rand, rand)
    end
    return captcha
end

-- Apply visual distortion to CAPTCHA text
local function distortCaptcha(textLabel)
    textLabel.Text = currentCaptcha
    
    -- Random rotation and position offsets for each character
    for i = 1, #currentCaptcha do
        local charLabel = Instance.new("TextLabel")
        charLabel.Name = "Char_"..i
        charLabel.Size = UDim2.new(0, 20, 1, 0)
        charLabel.Position = UDim2.new((i-1)/#currentCaptcha, math.random(-5, 5), 0, math.random(-5, 5))
        charLabel.BackgroundTransparency = 1
        charLabel.Text = string.sub(currentCaptcha, i, i)
        charLabel.Font = Enum.Font.SourceSansBold
        charLabel.TextColor3 = Color3.new(1, 1, 1)
        charLabel.TextSize = 24
        charLabel.Rotation = math.random(-15, 15)
        charLabel.Parent = textLabel
    end
end

-- Refresh CAPTCHA
local function refreshCaptcha()
    -- Clear previous characters
    for _, child in ipairs(captchaText:GetChildren()) do
        child:Destroy()
    end
    
    -- Generate new CAPTCHA
    currentCaptcha = generateCaptcha()
    distortCaptcha(captchaText)
    inputBox.Text = ""
    statusMessage.Visible = false
end

-- Initial CAPTCHA generation
refreshCaptcha()

-- Submit Button Logic
submitButton.MouseButton1Click:Connect(function()
    local userInput = string.upper(inputBox.Text)
    userInput = string.gsub(userInput, "%s+", "") -- Remove spaces
    
    if userInput == currentCaptcha then
        -- Success
        statusMessage.Text = "Verification successful!"
        statusMessage.TextColor3 = Color3.fromRGB(50, 255, 50)
        statusMessage.Visible = true
        
        -- Close CAPTCHA after 2 seconds
        wait(2)
        captchaUI:Destroy()
    else
        -- Failure
        statusMessage.Text = "Incorrect CAPTCHA. Try again."
        statusMessage.TextColor3 = Color3.fromRGB(255, 50, 50)
        statusMessage.Visible = true
        refreshCaptcha()
    end
end)

-- Refresh Button Logic
refreshButton.MouseButton1Click:Connect(function()
    refreshCaptcha()
end)
